{
  "name": "@flex-development/jaymark",
  "description": "json language parser",
  "version": "0.0.0",
  "keywords": [],
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/flex-development/jaymark",
  "repository": {
    "directory": "examples/jaymark",
    "type": "git",
    "url": "git+https://github.com/flex-development/jaymark.git"
  },
  "bugs": "https://github.com/flex-development/jaymark/issues",
  "author": {
    "name": "Lexus Drumgold",
    "url": "https://github.com/unicornware"
  },
  "publishConfig": {
    "access": "public",
    "diff-dst-prefix": "jaymark",
    "diff-src-prefix": "jaymark",
    "directory": "./",
    "executableFiles": [],
    "node-options": null,
    "pack-destination": ".",
    "parseable": true,
    "prefer-dedupe": true,
    "provenance": true,
    "tag-version-prefix": ""
  },
  "type": "module",
  "files": [
    "LICENSE.md",
    "README.md",
    "dist"
  ],
  "exports": {
    ".": {
      "docmark": "./src/index.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#fixtures/*": "./__fixtures__/*.mts",
    "#tests/*": "./__tests__/*.mts"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "attw": "tsc --build tsconfig.build.json --clean --dry && tsc --build tsconfig.build.json --clean && tsc --build tsconfig.build.json --verbose"
  },
  "dependencies": {
    "@flex-development/docmark": "workspace:1.0.0-alpha.19",
    "@flex-development/docmark-extension-tags": "workspace:*",
    "@flex-development/docmark-factory-block": "workspace:1.0.0-alpha.12",
    "@flex-development/docmark-factory-line": "workspace:1.0.0-alpha.15",
    "@flex-development/docmark-factory-space": "workspace:1.0.0-alpha.19",
    "@flex-development/docmark-grammar": "workspace:1.0.0-alpha.19",
    "@flex-development/docmark-util-combine-extensions": "workspace:1.0.0-alpha.19",
    "@flex-development/docmark-util-symbol": "workspace:1.0.0-alpha.11",
    "@flex-development/docmark-util-types": "workspace:1.0.0-alpha.19",
    "@flex-development/mark-util-character": "1.1.0",
    "devlop": "1.1.0",
    "vfile-message": "4.0.3"
  },
  "devDependencies": {
    "@flex-development/docmark-factory-markers": "workspace:1.0.0-alpha.19"
  },
  "sideEffects": false,
  "private": true
}
